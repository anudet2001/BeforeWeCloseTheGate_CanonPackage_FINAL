{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Before We Close the Gate EP01 Final Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_id",
    "package_name",
    "version",
    "release_date",
    "project",
    "episode",
    "episode_title",
    "status",
    "metrics",
    "sla_policy",
    "workflow_state",
    "file_count",
    "checksum_algorithm",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0"
    },
    "package_id": {
      "type": "string",
      "pattern": "^BWCTG-EP01-FINAL-[0-9]{8}$"
    },
    "package_name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "const": "FINAL"
    },
    "release_date": {
      "type": "string",
      "format": "date-time"
    },
    "project": {
      "type": "string"
    },
    "episode": {
      "type": "string",
      "const": "EP01"
    },
    "episode_title": {
      "type": "string"
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_status",
        "cci",
        "risk_level",
        "production_status",
        "release_status"
      ],
      "properties": {
        "canon_status": {
          "type": "string"
        },
        "cci": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "risk_level": {
          "type": "string"
        },
        "production_status": {
          "type": "string"
        },
        "release_status": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "scene_count",
        "frame_count",
        "image_prompts",
        "motion_prompts",
        "negative_prompts"
      ],
      "properties": {
        "scene_count": {
          "type": "integer",
          "minimum": 0
        },
        "frame_count": {
          "type": "integer",
          "minimum": 0
        },
        "image_prompts": {
          "type": "integer",
          "minimum": 0
        },
        "motion_prompts": {
          "type": "integer",
          "minimum": 0
        },
        "negative_prompts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "sla_policy": {
      "type": "object",
      "required": [
        "at_risk_threshold_percent",
        "statuses"
      ],
      "properties": {
        "at_risk_threshold_percent": {
          "type": "integer",
          "const": 20
        },
        "statuses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "uniqueItems": true
        }
      }
    },
    "workflow_state": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "complete",
          "pending",
          "not_started"
        ]
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "checksum_algorithm": {
      "type": "string",
      "const": "SHA-256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "category",
          "media_type",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "canon",
              "executive",
              "editing",
              "documentation"
            ]
          },
          "media_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}